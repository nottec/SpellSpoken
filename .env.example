# Optional. Without a key the game uses built-in template coaching and keyless hints from Eco.
GEMINI_API_KEY=
# Model name; if Google retires it, the 404 error in your terminal names the replacement.
# Comma-separated: each is tried in turn when the previous is overloaded (503) or retired (404).
GEMINI_MODEL=gemini-3.8-flash,gemini-3.8-flash-lite
# Per-attempt timeout for Gemini calls (ms). Requests slower than this fall back to template text.
GEMINI_TIMEOUT_MS=12000
