# Optional. Without a key the game uses built-in template coaching and keyless hints from Eco.
# Get one at https://aistudio.google.com/apikey — see README → "Gemini setup" for the quota notes.
# A fresh key is on the free tier (≈ 5–15 requests/min, 100–250/day per model, per Cloud project).
GEMINI_API_KEY=

# Audio coaching (/api/feedback) and Eco (/api/mentor). Comma-separated fallback list, tried in order.
# If Google retires a name, GET /api/health?ping=1 lists the models your key can use.
GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash

# Bulk vocabulary JSON (/api/vocab): cheaper lite models first, then the list above.
GEMINI_MODEL_LITE=gemini-3.8-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash

# Per-attempt timeout (ms). A model that is slower than this is skipped for the next one;
# when every model fails the route answers with template text. The game never waits on Gemini.
GEMINI_TIMEOUT_MS=12000
